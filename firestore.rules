rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidProfile(data, userId) {
      return data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.monthlyBudget is number && data.monthlyBudget >= 0 && data.monthlyBudget <= 1000000000 &&
             data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 4 &&
             data.totalXp is int && data.totalXp >= 0 && data.totalXp <= 10000000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
             data.type is string && data.type in ['EXPENSE', 'INCOME'] &&
             data.category is string && data.category in [
               'FOOD', 'TRAVEL', 'SHOPPING', 'BILLS', 'ENTERTAINMENT',
               'HEALTH', 'EDUCATION', 'OTHERS', 'SALARY', 'FREELANCE', 'INVESTMENT'
             ] &&
             data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.timestampEpochMs is int && data.timestampEpochMs > 0 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 240)) &&
             (!('isTripOrEvent' in data) || data.isTripOrEvent is bool) &&
             (!('eventName' in data) || (data.eventName is string && data.eventName.size() <= 60)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidHabit(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 60 &&
             data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 30 &&
             data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 12 &&
             data.targetDaysPerWeek is int && data.targetDaysPerWeek >= 1 && data.targetDaysPerWeek <= 7 &&
             data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000 &&
             data.longestStreak is int && data.longestStreak >= 0 && data.longestStreak <= 10000 &&
             data.completedDates is list && data.completedDates.size() <= 366 &&
             (data.completedDates.size() == 0 || data.completedDates[0] is string) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidGoal(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 60 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 30 &&
             data.targetAmount is number && data.targetAmount > 0 && data.targetAmount <= 1000000000 &&
             data.savedAmount is number && data.savedAmount >= 0 && data.savedAmount <= 1000000000 &&
             data.completed is bool &&
             data.targetMonth is string && data.targetMonth.size() <= 20 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTask(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.cadence is string && data.cadence in ['DAILY', 'WEEKLY'] &&
             data.priority is string && data.priority in ['HIGH', 'MEDIUM', 'LOW'] &&
             data.status is string && data.status in ['TODO', 'IN_PROGRESS', 'DONE'] &&
             data.dueDateEpochMs is int && data.dueDateEpochMs >= 0 &&
             data.recurring is bool &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidReminder(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.category is string && data.category in ['BILL', 'EMI', 'RENT', 'SUBSCRIPTION'] &&
             data.amount is number && data.amount >= 0 && data.amount <= 100000000 &&
             data.dueDateEpochMs is int && data.dueDateEpochMs > 0 &&
             data.recurringMonthly is bool &&
             data.paid is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAchievement(data, userId) {
      return data.userId == userId &&
             data.code is string && data.code.size() >= 1 && data.code.size() <= 40 &&
             data.xpAwarded is int && data.xpAwarded >= 0 && data.xpAwarded <= 10000 &&
             data.unlocked is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSettings(data, userId) {
      return data.userId == userId &&
             data.themeMode is string && data.themeMode in ['SYSTEM', 'DARK', 'LIGHT'] &&
             data.notificationsEnabled is bool &&
             data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 4 &&
             data.monthlyBudget is number && data.monthlyBudget >= 0 && data.monthlyBudget <= 1000000000 &&
             (!('separateTripEventLedger' in data) || data.separateTripEventLedger is bool) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- USER-SCOPED COLLECTIONS ---
    match /users/{userId} {

      // 1. Profile
      match /profile/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(docId) &&
                         incoming().keys().hasAll(['userId', 'displayName', 'monthlyBudget', 'currencySymbol', 'totalXp', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'monthlyBudget', 'currencySymbol', 'totalXp', 'createdAt', 'updatedAt']) &&
                         isValidProfile(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(docId) &&
                         isValidProfile(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'email', 'photoUrl', 'monthlyBudget', 'currencySymbol', 'totalXp', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(docId);
      }

      // 2. Transactions
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         incoming().keys().hasAll(['userId', 'title', 'amount', 'type', 'category', 'monthKey', 'timestampEpochMs', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'amount', 'type', 'category', 'monthKey', 'timestampEpochMs', 'note', 'isTripOrEvent', 'eventName', 'createdAt', 'updatedAt']) &&
                         isValidTransaction(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'amount', 'type', 'category', 'monthKey', 'timestampEpochMs', 'note', 'isTripOrEvent', 'eventName', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // 3. Habits
      match /habits/{habitId} {
        allow get: if isOwner(userId) && isValidId(habitId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(habitId) &&
                         incoming().keys().hasAll(['userId', 'title', 'iconKey', 'colorHex', 'targetDaysPerWeek', 'currentStreak', 'longestStreak', 'completedDates', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'iconKey', 'colorHex', 'targetDaysPerWeek', 'currentStreak', 'longestStreak', 'completedDates', 'createdAt', 'updatedAt']) &&
                         isValidHabit(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(habitId) &&
                         isValidHabit(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'iconKey', 'colorHex', 'targetDaysPerWeek', 'currentStreak', 'longestStreak', 'completedDates', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(habitId);
      }

      // 4. Savings Goals
      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(goalId) &&
                         incoming().keys().hasAll(['userId', 'title', 'category', 'targetAmount', 'savedAmount', 'completed', 'targetMonth', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'category', 'targetAmount', 'savedAmount', 'completed', 'targetMonth', 'createdAt', 'updatedAt']) &&
                         isValidGoal(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(goalId) &&
                         isValidGoal(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'category', 'targetAmount', 'savedAmount', 'completed', 'targetMonth', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      // 5. Tasks
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll(['userId', 'title', 'cadence', 'priority', 'status', 'dueDateEpochMs', 'recurring', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'cadence', 'priority', 'status', 'dueDateEpochMs', 'recurring', 'notes', 'createdAt', 'updatedAt']) &&
                         isValidTask(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidTask(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'cadence', 'priority', 'status', 'dueDateEpochMs', 'recurring', 'notes', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // 6. Reminders
      match /reminders/{reminderId} {
        allow get: if isOwner(userId) && isValidId(reminderId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(reminderId) &&
                         incoming().keys().hasAll(['userId', 'title', 'category', 'amount', 'dueDateEpochMs', 'recurringMonthly', 'paid', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'category', 'amount', 'dueDateEpochMs', 'recurringMonthly', 'paid', 'createdAt', 'updatedAt']) &&
                         isValidReminder(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(reminderId) &&
                         isValidReminder(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'category', 'amount', 'dueDateEpochMs', 'recurringMonthly', 'paid', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(reminderId);
      }

      // 7. Achievements
      match /achievements/{achievementId} {
        allow get: if isOwner(userId) && isValidId(achievementId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(achievementId) &&
                         incoming().keys().hasAll(['userId', 'code', 'xpAwarded', 'unlocked', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'code', 'xpAwarded', 'unlocked', 'createdAt', 'updatedAt']) &&
                         isValidAchievement(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(achievementId) &&
                         isValidAchievement(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().code == existing().code &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'xpAwarded', 'unlocked', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(achievementId);
      }

      // 8. Settings
      match /settings/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(docId) &&
                         incoming().keys().hasAll(['userId', 'themeMode', 'notificationsEnabled', 'currencySymbol', 'monthlyBudget', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'themeMode', 'notificationsEnabled', 'currencySymbol', 'monthlyBudget', 'separateTripEventLedger', 'createdAt', 'updatedAt']) &&
                         isValidSettings(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(docId) &&
                         isValidSettings(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'themeMode', 'notificationsEnabled', 'currencySymbol', 'monthlyBudget', 'separateTripEventLedger', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(docId);
      }
    }
  }
}
